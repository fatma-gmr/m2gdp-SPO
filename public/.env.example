# Configuration Firebase du projet BINOFIT
# 1. Crée un projet sur https://console.firebase.google.com
# 2. Ajoute une application Web et copie les valeurs ci-dessous
# 3. Copie ce fichier en ".env" (non versionné) et remplis les valeurs
# 4. Dans Authentication > Sign-in method, active "E-mail link (sans mot de passe)"
# 5. Dans Authentication > Settings > Authorized domains, ajoute ton domaine (localhost est déjà autorisé)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
